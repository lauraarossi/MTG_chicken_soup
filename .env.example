POSTGRES_PASSWORD=mtgpassword
DATABASE_URL=postgresql+asyncpg://mtg_user:mtgpassword@db:5432/mtg_chicken_soup

# --- Claude API (production inference) ---
# Get a key at https://console.anthropic.com
# Cost: ~$0.02-0.03 per chat turn with claude-opus-4-8
# Use MODEL_NAME=claude-haiku-4-5 for ~10x cheaper responses
ANTHROPIC_API_KEY=
# MODEL_NAME=claude-haiku-4-5

# --- Free online inference (no local GPU, no API costs) ---
# Any OpenAI-compatible provider works: GitHub Models, Groq, Cerebras, OpenRouter, etc.
# Takes precedence over Claude when set; Ollama still wins if also configured.
#
# GitHub Models (free with a GitHub account):
#   1. Get a token at https://github.com/settings/tokens (no scopes needed)
#   2. Pick a model name from https://github.com/marketplace/models
# FREE_API_KEY=github_pat_...
# FREE_API_BASE_URL=https://models.inference.ai.azure.com
# FREE_MODEL=Meta-Llama-3.1-70B-Instruct
#
# Groq:     FREE_API_BASE_URL=https://api.groq.com/openai/v1  FREE_MODEL=llama-3.3-70b-versatile
# Cerebras: FREE_API_BASE_URL=https://api.cerebras.ai/v1     FREE_MODEL=llama-3.3-70b
# (Groq/Cerebras base URLs include /v1; GitHub Models does not — the code handles the difference)

# --- Ollama (local dev inference — no API costs, requires Docker) ---
# Start with: docker compose --profile local-llm up
# Then pull: docker compose exec ollama ollama pull llama3.2
# Set OLLAMA_MODEL to activate (takes precedence over everything)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://ollama:11434

# --- RAG embeddings ---
# Requires Ollama running with nomic-embed-text pulled:
#   docker compose exec ollama ollama pull nomic-embed-text
# Then run: make embed-cards
# EMBEDDING_MODEL=nomic-embed-text
